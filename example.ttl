@prefix gmont: <https://matinabtahi.github.io/Generational-Memory-Ontology-GMOnt/GMOnt#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.org/gmont-family-demo#> .

# Human/family-memory application example.

ex:Alice a gmont:Person ;
    gmont:name "Alice Thompson" ;
    gmont:birthDate "1945-07-12"^^xsd:date .

ex:Robert a gmont:Person ;
    gmont:name "Robert Thompson" ;
    gmont:birthDate "1970-05-03"^^xsd:date ;
    gmont:childOf ex:Alice .

ex:Laura a gmont:Person ;
    gmont:name "Laura Thompson" ;
    gmont:birthDate "2000-09-17"^^xsd:date ;
    gmont:childOf ex:Robert .

ex:Generation1 a gmont:Generation ;
    rdfs:label "first family generation"@en ;
    gmont:includesEntity ex:Alice .

ex:Generation2 a gmont:Generation ;
    rdfs:label "second family generation"@en ;
    gmont:followsGeneration ex:Generation1 ;
    gmont:includesEntity ex:Robert .

ex:Generation3 a gmont:Generation ;
    rdfs:label "third family generation"@en ;
    gmont:followsGeneration ex:Generation2 ;
    gmont:includesEntity ex:Laura .

ex:Memory2005 a gmont:Memory ;
    gmont:title "Migration recollection" ;
    gmont:contentText "Alice records a recollection for the family archive." ;
    gmont:recordedBy ex:Alice ;
    gmont:aboutPerson ex:Alice ;
    gmont:recordDate "2005-04-02"^^xsd:date ;
    gmont:belongsToGeneration ex:Generation1 ;
    gmont:hasMedia ex:Audio2005 .

ex:Audio2005 a gmont:MediaObject ;
    gmont:mediaType "audio/mpeg" ;
    gmont:formatLabel "oral-history audio" ;
    gmont:fileURI "https://example.org/archive/alice-2005.mp3"^^xsd:anyURI .

ex:Memory2021 a gmont:Memory ;
    gmont:title "Intergenerational reflection" ;
    gmont:contentText "Laura creates a video record reflecting on Alice's earlier account." ;
    gmont:recordedBy ex:Laura ;
    gmont:aboutPerson ex:Alice ;
    gmont:recordDate "2021-06-12"^^xsd:date ;
    gmont:previousRecord ex:Memory2005 ;
    gmont:sameSubjectAs ex:Memory2005 ;
    gmont:belongsToGeneration ex:Generation3 ;
    gmont:hasMedia ex:Video2021 .

ex:Video2021 a gmont:MediaObject ;
    gmont:mediaType "video/mp4" ;
    gmont:formatLabel "documentary video" ;
    gmont:fileURI "https://example.org/archive/laura-2021.mp4"^^xsd:anyURI .
