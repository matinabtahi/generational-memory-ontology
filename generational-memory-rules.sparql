PREFIX gmont: <https://matinabtahi.github.io/Generational-Memory-Ontology-GMOnt/GMOnt#>

# GMOnt v1.0.0 — example longitudinal inference/query patterns.

# 1. Materialise forward links from previousRecord.
CONSTRUCT {
  ?older gmont:nextRecord ?newer .
}
WHERE {
  ?newer gmont:previousRecord ?older .
};

# 2. Link records that explicitly document the same persistent entity.
CONSTRUCT {
  ?r1 gmont:sameSubjectAs ?r2 .
}
WHERE {
  ?r1 gmont:aboutEntity ?entity .
  ?r2 gmont:aboutEntity ?entity .
  FILTER(?r1 != ?r2)
};

# 3. Retrieve a longitudinal record sequence for one entity.
SELECT DISTINCT ?record ?date ?media ?mediaType
WHERE {
  ?record gmont:aboutEntity ?entity ;
          gmont:recordDate ?date .
  OPTIONAL {
    ?record gmont:hasMedia ?media .
    OPTIONAL { ?media gmont:mediaType ?mediaType . }
  }
}
ORDER BY ?date;

# 4. Retrieve multimodal representations associated with the same subject.
SELECT DISTINCT ?entity ?record ?date ?media ?mediaType
WHERE {
  ?record gmont:aboutEntity ?entity ;
          gmont:recordDate ?date ;
          gmont:hasMedia ?media .
  ?media gmont:mediaType ?mediaType .
}
ORDER BY ?entity ?date ?mediaType;

# 5. Human-memory specialization: infer ancestors from parent links.
CONSTRUCT {
  ?ancestor gmont:ancestorOf ?descendant .
}
WHERE {
  ?ancestor (gmont:parentOf)+ ?descendant .
  FILTER(?ancestor != ?descendant)
};
