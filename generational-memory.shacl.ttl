@prefix gmont: <https://matinabtahi.github.io/Generational-Memory-Ontology-GMOnt/GMOnt#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Lightweight integrity constraints for GMOnt v1.0.0.

gmont:ArchivalRecordShape a sh:NodeShape ;
    sh:targetClass gmont:ArchivalRecord ;
    sh:property [ sh:path gmont:recordDate ; sh:datatype xsd:date ; sh:maxCount 1 ] ;
    sh:property [ sh:path gmont:aboutEntity ; sh:class gmont:Entity ] ;
    sh:property [ sh:path gmont:hasMedia ; sh:class gmont:MediaObject ] ;
    sh:property [ sh:path gmont:previousRecord ; sh:class gmont:ArchivalRecord ] ;
    sh:property [ sh:path gmont:nextRecord ; sh:class gmont:ArchivalRecord ] ;
    sh:property [ sh:path gmont:sameSubjectAs ; sh:class gmont:ArchivalRecord ] .

gmont:MemoryShape a sh:NodeShape ;
    sh:targetClass gmont:Memory ;
    sh:property [ sh:path gmont:recordedBy ; sh:class gmont:Agent ; sh:minCount 1 ] ;
    sh:property [ sh:path gmont:contentText ; sh:datatype xsd:string ] .

gmont:MediaObjectShape a sh:NodeShape ;
    sh:targetClass gmont:MediaObject ;
    sh:property [ sh:path gmont:fileURI ; sh:datatype xsd:anyURI ; sh:minCount 1 ] ;
    sh:property [ sh:path gmont:mediaType ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path gmont:derivedFrom ; sh:class gmont:MediaObject ] .

gmont:RelationshipShape a sh:NodeShape ;
    sh:targetClass gmont:Relationship ;
    sh:property [ sh:path gmont:hasParticipant ; sh:class gmont:Agent ; sh:minCount 2 ] ;
    sh:property [ sh:path gmont:relationshipType ; sh:class gmont:Role ; sh:minCount 1 ; sh:maxCount 1 ] .

gmont:GenerationShape a sh:NodeShape ;
    sh:targetClass gmont:Generation ;
    sh:property [ sh:path gmont:includesEntity ; sh:class gmont:Entity ; sh:minCount 1 ] ;
    sh:property [ sh:path gmont:followsGeneration ; sh:class gmont:Generation ; sh:maxCount 1 ] .

gmont:ConfidenceShape a sh:NodeShape ;
    sh:targetSubjectsOf gmont:confidence ;
    sh:property [
        sh:path gmont:confidence ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1
    ] .
