@prefix : <https://matinabtahi.github.io/Generational-Memory-Ontology-GMOnt/GMOnt#> .
@prefix gmont: <https://matinabtahi.github.io/Generational-Memory-Ontology-GMOnt/GMOnt#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://matinabtahi.github.io/Generational-Memory-Ontology-GMOnt/GMOnt>
    a owl:Ontology ;
    dcterms:title "Generational Memory Ontology (GMOnt)"@en ;
    dcterms:creator <https://orcid.org/0000-0003-3941-9485> ;
    dcterms:license <https://opensource.org/license/mit> ;
    rdfs:label "Generational Memory Ontology (GMOnt)"@en ;
    rdfs:comment "A lightweight OWL ontology for longitudinal multimodal archives: linking records, entities, events and media across time, versions and formats without assuming a specific application domain."@en ;
    owl:versionInfo "1.0.0" .

gmont:Entity a owl:Class ; rdfs:label "entity"@en ; rdfs:comment "Anything that archival records may describe or track through time."@en .
gmont:Agent a owl:Class ; rdfs:subClassOf gmont:Entity ; rdfs:label "agent"@en .
gmont:Person a owl:Class ; rdfs:subClassOf gmont:Agent, schema:Person ; rdfs:label "person"@en .
gmont:Organization a owl:Class ; rdfs:subClassOf gmont:Agent, schema:Organization ; rdfs:label "organization"@en .
gmont:Place a owl:Class ; rdfs:subClassOf gmont:Entity, schema:Place ; rdfs:label "place"@en .
gmont:Object a owl:Class ; rdfs:subClassOf gmont:Entity ; rdfs:label "object"@en ; rdfs:comment "A persistent physical or conceptual object tracked through an archive, such as an artefact, asset, component, document set or building."@en .
gmont:Event a owl:Class ; rdfs:subClassOf gmont:Entity, schema:Event ; rdfs:label "event"@en .
gmont:Generation a owl:Class ; rdfs:subClassOf gmont:Entity ; rdfs:label "generation"@en ; rdfs:comment "A cohort or stage used to group related entities or records across a temporal sequence."@en .
gmont:ArchivalRecord a owl:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "archival record"@en ; rdfs:comment "A record that captures information about one or more entities at a point or interval in time."@en .
gmont:Memory a owl:Class ; rdfs:subClassOf gmont:ArchivalRecord ; rdfs:label "memory"@en ; rdfs:comment "A human-centred archival record describing an experience, recollection or account."@en .
gmont:MediaObject a owl:Class ; rdfs:subClassOf prov:Entity, schema:MediaObject ; rdfs:label "media object"@en ; rdfs:comment "A digital representation associated with an archival record, such as text, image, audio, video, scan, model or dataset."@en .
gmont:Relationship a owl:Class ; rdfs:label "relationship"@en .
gmont:Role a owl:Class ; rdfs:subClassOf skos:Concept ; rdfs:label "role"@en .

gmont:aboutEntity a owl:ObjectProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Entity ; rdfs:label "about entity"@en .
gmont:aboutPerson a owl:ObjectProperty ; rdfs:subPropertyOf gmont:aboutEntity ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Person .
gmont:aboutOrganization a owl:ObjectProperty ; rdfs:subPropertyOf gmont:aboutEntity ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Organization .
gmont:aboutPlace a owl:ObjectProperty ; rdfs:subPropertyOf gmont:aboutEntity ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Place .
gmont:aboutObject a owl:ObjectProperty ; rdfs:subPropertyOf gmont:aboutEntity ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Object .
gmont:aboutEvent a owl:ObjectProperty ; rdfs:subPropertyOf gmont:aboutEntity ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Event .
gmont:recordedBy a owl:ObjectProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Agent .
gmont:hasMedia a owl:ObjectProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:MediaObject .
gmont:representsRecord a owl:ObjectProperty ; rdfs:domain gmont:MediaObject ; rdfs:range gmont:ArchivalRecord ; owl:inverseOf gmont:hasMedia .
gmont:previousRecord a owl:ObjectProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:ArchivalRecord ; rdfs:label "previous record"@en ; rdfs:comment "Links a record to an earlier record in the same longitudinal thread."@en .
gmont:nextRecord a owl:ObjectProperty ; owl:inverseOf gmont:previousRecord ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:ArchivalRecord .
gmont:relatedRecord a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:ArchivalRecord .
gmont:sameSubjectAs a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:ArchivalRecord ; rdfs:comment "Indicates records that document the same persistent subject at different times or in different formats."@en .
gmont:derivedFrom a owl:ObjectProperty ; rdfs:domain gmont:MediaObject ; rdfs:range gmont:MediaObject ; rdfs:subPropertyOf prov:wasDerivedFrom .
gmont:belongsToGeneration a owl:ObjectProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range gmont:Generation .
gmont:includesEntity a owl:ObjectProperty ; rdfs:domain gmont:Generation ; rdfs:range gmont:Entity .
gmont:memberOfGeneration a owl:ObjectProperty ; owl:inverseOf gmont:includesEntity ; rdfs:domain gmont:Entity ; rdfs:range gmont:Generation .
gmont:followsGeneration a owl:ObjectProperty ; rdfs:domain gmont:Generation ; rdfs:range gmont:Generation .

gmont:parentOf a owl:ObjectProperty ; rdfs:domain gmont:Person ; rdfs:range gmont:Person ; owl:inverseOf gmont:childOf .
gmont:childOf a owl:ObjectProperty ; rdfs:domain gmont:Person ; rdfs:range gmont:Person .
gmont:siblingOf a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain gmont:Person ; rdfs:range gmont:Person .
gmont:spouseOf a owl:ObjectProperty, owl:SymmetricProperty ; rdfs:domain gmont:Person ; rdfs:range gmont:Person .
gmont:ancestorOf a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:domain gmont:Person ; rdfs:range gmont:Person ; owl:inverseOf gmont:descendantOf .
gmont:descendantOf a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:domain gmont:Person ; rdfs:range gmont:Person .

gmont:hasRelationship a owl:ObjectProperty ; rdfs:domain gmont:Agent ; rdfs:range gmont:Relationship .
gmont:hasParticipant a owl:ObjectProperty ; rdfs:domain gmont:Relationship ; rdfs:range gmont:Agent .
gmont:relationshipType a owl:ObjectProperty ; rdfs:domain gmont:Relationship ; rdfs:range gmont:Role .
gmont:participantRole a owl:ObjectProperty ; rdfs:domain gmont:Relationship ; rdfs:range gmont:Role .

gmont:name a owl:DatatypeProperty ; rdfs:domain gmont:Entity ; rdfs:range xsd:string .
gmont:title a owl:DatatypeProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range xsd:string .
gmont:contentText a owl:DatatypeProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range xsd:string .
gmont:recordDate a owl:DatatypeProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range xsd:date .
gmont:dateRecorded a owl:DatatypeProperty ; rdfs:subPropertyOf gmont:recordDate ; rdfs:domain gmont:Memory ; rdfs:range xsd:date .
gmont:eventDate a owl:DatatypeProperty ; rdfs:domain gmont:Event ; rdfs:range xsd:date .
gmont:birthDate a owl:DatatypeProperty ; rdfs:domain gmont:Person ; rdfs:range xsd:date .
gmont:deathDate a owl:DatatypeProperty ; rdfs:domain gmont:Person ; rdfs:range xsd:date .
gmont:fileURI a owl:DatatypeProperty ; rdfs:domain gmont:MediaObject ; rdfs:range xsd:anyURI .
gmont:mediaType a owl:DatatypeProperty ; rdfs:domain gmont:MediaObject ; rdfs:range xsd:string ; rdfs:comment "MIME type or other explicit format identifier."@en .
gmont:formatLabel a owl:DatatypeProperty ; rdfs:domain gmont:MediaObject ; rdfs:range xsd:string .
gmont:identifier a owl:DatatypeProperty ; rdfs:domain [ a owl:Class ; owl:unionOf (gmont:Entity gmont:ArchivalRecord gmont:MediaObject) ] ; rdfs:range xsd:string .
gmont:source a owl:DatatypeProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range xsd:anyURI .
gmont:confidence a owl:DatatypeProperty ; rdfs:domain gmont:ArchivalRecord ; rdfs:range xsd:decimal .
gmont:relationshipStart a owl:DatatypeProperty ; rdfs:domain gmont:Relationship ; rdfs:range xsd:date .
gmont:relationshipEnd a owl:DatatypeProperty ; rdfs:domain gmont:Relationship ; rdfs:range xsd:date .
